<!-- Test-only logging. The app's logback.xml logs at TRACE, which buries the test
     results under tens of thousands of routing/driver lines. Tests keep WARN and up,
     so a failing test's own output is still visible. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="warn">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
