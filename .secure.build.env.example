# Copy to .secure.build.env (gitignored) and fill in. mise loads it only for the deploy:build, deploy:push and deploy
# tasks, and deploy/scripts/lib.sh keeps it out of Gradle's and mise's environment. Docker Hub login is separate:
# run `docker login` once on this machine.

# Docker Hub repositories for the two images, e.g. yourname/bag-please-back. Tags are the gradle.properties version
# only; `latest` is never pushed.
DOCKER_IMAGE_BACK=
DOCKER_IMAGE_FRONT=
