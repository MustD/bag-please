# Copy to .secure.deploy.env (gitignored) and fill in. mise loads it only for the infra and db tasks, so none of it
# reaches an interactive shell, and the scripts keep it out of Gradle's environment (deploy/scripts/lib.sh).

# DigitalOcean API token with read/write on droplets, firewalls and databases, read on SSH keys and VPCs. Terraform
# (infra:plan, infra:apply) only.
DIGITALOCEAN_TOKEN=

# Spaces key for Terraform's S3 backend (the io-workshop-tfstate bucket, issued by the io-workshop-hub stack).
# Every task needs it: `terraform output` reads the remote state.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# user@host of the edge proxy, used as the SSH jump host: ssh -J $EDGE_SSH deploy@<droplet private ip>
EDGE_SSH=

# Private VPC IP of the edge. The only address the droplet firewall lets reach ports 80 and 22.
TF_VAR_edge_private_ip=

# Name of the existing VPC the edge lives in; the droplet and the database cluster join it.
TF_VAR_vpc_name=

# Name of an SSH key already in the DigitalOcean account (Settings -> Security). Its public key is what the deploy
# user gets; Terraform looks it up rather than uploading one, because DO refuses a duplicate.
TF_VAR_ssh_key_name=
