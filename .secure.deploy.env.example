# Copy to .secure.deploy.env (gitignored) and fill in. mise loads it only for the infra, db and deploy tasks, so none of it
# reaches an interactive shell, and the scripts keep it out of Gradle's environment (deploy/scripts/lib.sh).

# DigitalOcean custom-scoped API token for Terraform (infra:plan, infra:apply) only. Scopes: droplet, firewall and
# database create/read/update/delete; tag create/read (the client tag, TF_VAR_pg_client_tag); read on ssh_key and vpc.
# DigitalOcean cannot scope database access below the whole account: this token can also modify or delete the SHARED
# PostgreSQL cluster other projects use. Keep it in this file only.
DIGITALOCEAN_TOKEN=

# Spaces key for Terraform's S3 backend (the shared io-workshop-tfstate bucket). Every task needs it: `terraform output`
# reads the remote state. The key is bucket-wide, so it can also write other stacks' state objects; no locking.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# user@host of the edge proxy, used as the SSH jump host: ssh -J $EDGE_SSH deploy@<droplet private ip>
EDGE_SSH=

# Private VPC IP of the edge. The only address the droplet firewall lets reach ports 80 and 22.
TF_VAR_edge_private_ip=

# Name of the existing VPC the edge lives in; the droplet joins it.
TF_VAR_vpc_name=

# Name of an SSH key already in the DigitalOcean account (Settings -> Security). Its public key is what the deploy
# user gets; Terraform looks it up rather than uploading one, because DO refuses a duplicate.
TF_VAR_ssh_key_name=

# Name of the shared PostgreSQL cluster (looked up, never created here).
TF_VAR_pg_cluster_name=

# Tag the cluster's database firewall trusts; the droplet carries it. A wrong value plans cleanly but is refused.
TF_VAR_pg_client_tag=

# The cluster's admin user and password (DigitalOcean: doadmin). db:bootstrap only, once; nothing else uses them.
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=

# Runtime secrets of the backend; `deploy` writes them to the droplet's .env (mode 600) over ssh, never anywhere else.
# JWT signing secret: a long random string. Changing it signs every user out.
KTOR_JWT_SECRET=
# The admin account's login and password (the backend's admin GraphQL gate).
KTOR_ADMIN_LOGIN=
KTOR_ADMIN_PASS=
